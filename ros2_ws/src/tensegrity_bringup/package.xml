<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tensegrity_bringup</name>
  <version>0.0.0</version>
  <description>Launch files for tensegrity ROS2 stack.</description>
  <maintainer email="pracsys@todo.todo">pracsys</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tensegrity_driver</exec_depend>
  <exec_depend>tensegrity_planning</exec_depend>
  <!-- pipeline.launch.py also needs tensegrity_perception installed in the same workspace (not a build dep so driver-only builds still work) -->
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
