<?xml version="1.0"?>
<package format="2">
  <name>tensegrity_planning</name>
  <version>0.0.0</version>
  <description>Planning nodes: A* and RL planners; subscribe to /state_msg, call perception GetPose, publish /action_msg.</description>

  <maintainer email="pracsys@todo.todo">pracsys</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>tensegrity_interfaces</build_depend>
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>tensegrity_interfaces</build_export_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tensegrity_interfaces</exec_depend>
  <!-- tensegrity_perception (external) required at runtime for get_pose service -->

  <export>
  </export>
</package>
